{
  "rewrites": [
    { "source": "/menu", "destination": "/src/pages/menu.html" },
    { "source": "/reviews", "destination": "/src/pages/reviews.html" },
    { "source": "/order", "destination": "/src/pages/order.html" },
    { "source": "/admin", "destination": "/src/pages/admin.html" },
    { "source": "/chef", "destination": "/src/pages/chef.html" },
    { "source": "/cashier", "destination": "/src/pages/cashier.html" },
    { "source": "/hostess", "destination": "/src/pages/hostess.html" },
    { "source": "/login", "destination": "/src/pages/login.html" },
    { "source": "/room", "destination": "/src/pages/room.html" },
    { "source": "/table", "destination": "/src/pages/table.html" }
  ],
  "headers": [
    {
      "source": "/cashier-sw.js",
      "headers": [
        { "key": "Service-Worker-Allowed", "value": "/" },
        { "key": "Cache-Control", "value": "max-age=0, no-cache" }
      ]
    },
    {
      "source": "/src/assets/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}