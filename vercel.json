{
  "rewrites": [
    {
      "source": "/assets/(.*)",
      "destination": "/src/assets/$1"
    },
    {
      "source": "/menu",
      "destination": "/src/pages/menu.html"
    },
    {
      "source": "/chef",
      "destination": "/src/pages/chef.html"
    },
    {
      "source": "/admin",
      "destination": "/src/pages/admin.html"
    },
    {
      "source": "/hostess",
      "destination": "/src/pages/hostess.html"
    },
    {
      "source": "/order",
      "destination": "/src/pages/order.html"
    },
    {
      "source": "/reviews",
      "destination": "/src/pages/reviews.html"
    }
  ],
  "cleanUrls": true
}