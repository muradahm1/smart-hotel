{
  "rewrites": [
    { "source": "/menu", "destination": "/src/pages/menu.html" },
    { "source": "/admin", "destination": "/src/pages/admin.html" },
    { "source": "/order", "destination": "/src/pages/order.html" },
    { "source": "/hostess", "destination": "/src/pages/hostess.html" },
    { "source": "/reviews", "destination": "/src/pages/reviews.html" },
    { "source": "/chef", "destination": "/src/pages/chef.html" },
    { "source": "/login", "destination": "/src/pages/login.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}